# Shared build-context excludes for all images in this repo.
# Both Dockerfiles (investment_agent/, mcp_server/) build from the repository
# root, so Docker reads this single context-root .dockerignore for every build.

# Version control / CI
.git
.github
.gitignore

# Python caches & build artifacts
__pycache__/
*.py[codz]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Tests & dev-only files
tests/
requirements-dev.txt
pytest.ini

# Secrets — never bake into the image (injected at deploy time)
.env
**/.env
*.envrc

# Editor / OS noise
.vscode/
.idea/
.DS_Store
